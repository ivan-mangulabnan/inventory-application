<section id="product-form" class="page">
  <a class="btn btn-back" href="/products">← Back to Products</a>
  <h2 id="product-form-title">Edit Product</h2>
  <div class="form-layout">
    <div class="card">
      <form action="/products/edit/<%=data.product.id%>?_method=PUT" method="post">
        <div class="form-group">
          <label for="name">Product Name</label>
          <input class="form-control" type="text" name="name" id="name" value="<%=data.product.name%>" placeholder="e.g., Zenbook Pro" required>
        </div>
        <div class="form-group">
          <label for="price">Price</label>
          <input type="number" id="price" name="price" class="form-control" value="<%=data.product.price%>" placeholder="e.g., 1499.00" required>
        </div>
        <div class="form-group">
          <label for="category">Category</label>
          <select class="form-control" name="category" id="category" required>
            <% data.categories.forEach(category => { %>
              <option value="<%=category.id%>" <%= data.product.category_id === category.id ? 'selected' : '' %>><%=category.name%></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary" data-route-to="products">Submit</button>
      </form>
    </div>
  </div>
</section>