<ul class="nav-list">
  <% navigations.forEach(nav => { %>
    <li class="nav-item">
      <% 
        let isActive = false;
        if(nav.href === '') {
          isActive = currentPath === '/';
        } else {
          isActive = currentPath.startsWith('/' + nav.href);
        }
      %>
      <a class="nav-link <%= isActive ? 'active' : '' %>" href="/<%= nav.href %>">
        <%- include('svg/' + nav.svg )%>
        <span><%= nav.link %></span>
      </a>
    </li>
  <% }) %>
</ul>