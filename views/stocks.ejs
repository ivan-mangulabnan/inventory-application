<div class="stocks">
  <% if (data.length <= 0) { %>
      <h2>No Stocks Yet</h2>
  <% } else { %>
      <ul>
    <% data.forEach(stock => { %>
        <li>
          <p><%= stock.name %></p>
          <p><%= stock.quantity %></p>
          <a href="/stocks/edit/<%= stock.product_id %>">EDIT</a>
          <form action="/stocks/delete/<%=stock.product_id%>?_method=DELETE" method="post">
            <button type="submit">DELETE</button>
          </form>
        </li>
    <% }) %>
    </ul>
  <% } %>
  <a href="/stocks/add">INCLUDE PRODUCT</a>
</div>