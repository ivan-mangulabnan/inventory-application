<div>
  <form action="/stocks/add" method="get">
    <input type="search" name="search">
    <button type="submit">search</button>
  </form>
  <% if (data) { %>
    <ul>
      <% data.forEach(product => { %>
        <li>
          <%=product.name%>
          <form action="/stocks/add/<%=product.id%>" method="post">
            <button type="submit">INCLUDE</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>