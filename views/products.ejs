<div class="products">
  <% if (data.length <= 0) { %>
      <h2>No Products Yet</h2>
  <% } else { %>
      <ul>
    <% data.forEach(product => { %>
        <li>
          <h3><%= product.name %></h3>
          <p><%= product.price %></p>
          <p><%= product.category %></p>
          <a href="/products/edit/<%=product.id%>">EDIT</a>
        </li>
    <% }) %>
    </ul>
  <% } %>
  <div>
    <a href="/products/add">ADD PRODUCT</a>
  </div>
</div>