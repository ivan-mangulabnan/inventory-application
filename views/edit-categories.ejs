<section class="page">
  <a class="btn btn-back" href="/categories">← Back to Categories</a>
  <h2 id="product-form-title">Edit Category</h2>
  <div class="form-layout">
    <div class="card">
      <form action="/categories/edit/<%=data.id%>?_method=PUT" method="post">
        <div class="form-group">
          <label for="name">Category Name</label>
          <input type="text" id="name" name="name" class="form-control" value="<%=data.name%>" placeholder="e.g., Soda" required>
        </div>
        <button type="submit" class="btn btn-primary">UPDATE</button>
      </form>
    </div>
  </div>
</section>