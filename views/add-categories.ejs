<section class="page">
  <a class="btn btn-back" href="/categories">← Back to Categories</a>
  <h2 id="product-form-title">Add Category</h2>
  <div class="form-layout">
    <div class="card">
      <form action="/categories/add" method="post">
        <div class="form-group">
          <label for="category">Category Name</label>
          <input type="text" id="category" name="category" class="form-control" placeholder="e.g., Soda" required>
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
      </form>
    </div>
  </div>
</section>