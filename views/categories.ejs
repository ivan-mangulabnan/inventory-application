<div class="categories">
  <% if (data.length <= 0) { %>
      <h2>No Categories Yet</h2>
  <% } else { %>
      <ul>
    <% data.forEach(category => { %>
        <li>
          <p><%= category.name %></p>
        </li>
    <% }) %>
    </ul>
  <% } %>
  <div>
    <a href="/categories/add">ADD CATEGORIES</a>
  </div>
</div>