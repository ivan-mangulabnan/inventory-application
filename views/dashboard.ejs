<section class="page">
  <h2>Dashboard</h2>
  <div class="analytics-grid">
    <div class="card">
      <h3>Total Products</h3>
      <p><%= data.totalProducts %></p>
    </div>
    <div class="card">
      <h3>Total Stocks</h3>
      <p><%= data.totalStocks %></p>
    </div>
    <div class="card">
      <h3>Total Categories</h3>
      <p><%= data.totalCategories %></p>
    </div>
    <div class="card">
      <h3>Products Without Stock</h3>
      <p><%= data.totalProductsWithoutStock %></p>
    </div>
    <div class="card">
      <h3>Total Products In Stock</h3>
      <p><%= data.totalProductsInStock %></p>
    </div>
    <div class="card">
      <h3>Total Unused Categories</h3>
      <p><%= data.totalUnusedCategories %></p>
    </div>
  </div>
</section>